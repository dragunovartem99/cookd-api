ALLOWED_ORIGIN=http://localhost:5173
# Google accounts allowed to sign in, comma-separated
ALLOWED_EMAILS=you@gmail.com
ANTHROPIC_API_KEY=
# Optional: spoonacular.com API key (free plan). Turns on real-recipe lookups;
# without it the coach answers from its own knowledge, with no links.
SPOONACULAR_API_KEY=
# Sign-in: set ADMIN_PASSWORD, GOOGLE_CLIENT_ID, or both.
# Password for POST /auth/login, signing in as the first ALLOWED_EMAILS address.
# 12+ characters, random: openssl rand -base64 24
ADMIN_PASSWORD=
# Optional: OAuth client ID from Google Cloud Console (Credentials -> Web application)
# turns on POST /auth/google
GOOGLE_CLIENT_ID=
# At least 32 random characters: openssl rand -hex 32
SESSION_SECRET=
DB_PATH=./cookd.db
PORT=50001
